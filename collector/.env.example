# Server only. Inject through your secret manager / Kubernetes Secret.
# COLLECTOR_MASTER_KEY=<random secret of at least 32 characters>
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=<private bucket>
# OSS_ACCESS_KEY_ID=<restricted service identity>
# OSS_ACCESS_KEY_SECRET=<secret>
# OSS_STS_TOKEN=<optional temporary token; rotation requires restart in this version>
# MYSQL_URL=mysql://<dedicated-user>:<url-encoded-password>@mysql:3306/<dedicated-database>
# Without MYSQL_URL, the collector keeps its local SQLite index in COLLECTOR_DATA.
# COLLECTOR_DATA=/data
# HOST=127.0.0.1
# PORT=4317
