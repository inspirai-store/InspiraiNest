{
  "name": "inspirainest-collector",
  "version": "0.2.43",
  "private": true,
  "type": "module",
  "main": "../apps/desktop/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "desktop": "npm --prefix .. run desktop",
    "desktop:ui": "npm run desktop",
    "desktop:ui:dev": "npm --prefix ../apps/desktop/frontend run dev",
    "stage:capture": "node scripts/stage-capture.mjs",
    "build:brand-icons": "node scripts/build-brand-icons.mjs",
    "build:macos-tray-icon": "node scripts/build-macos-tray-icon.mjs",
    "test": "node --test test/*.test.mjs",
    "doctor": "node src/worker.mjs doctor",
