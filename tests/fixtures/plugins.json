      "defaultEnabled": false,
      "dependencies": [
        "ai-assistant"
      ],
      "platforms": [
        "web",
        "desktop",
        "android",
        "ios",
        "cli",
        "worker",
        "server"
      ],
      "capabilities": [
        "agent-lab.trials"
      ],
      "contributes": {
        "navigation": [],
        "settings": true,
        "jobs": [
          "agent-lab.trials"
        ]
      },
      "enabled": false
    },
    {
      "id": "ai-assistant",
      "name": "AI 助手",
      "version": "1.0.0",
      "hostVersion": 1,
      "defaultEnabled": true,
      "dependencies": [],
      "platforms": [
        "web",
        "desktop",
        "android",
        "ios",
        "cli",
        "worker",
        "server"
      ],
      "capabilities": [
        "ai.process",
        "ai.agents",
        "ai.skills"
      ],
      "contributes": {
        "navigation": [],
        "settings": true,
        "jobs": [
          "ai.process",
          "ai.agents",
          "ai.skills"
        ]
      },
      "enabled": true
    },
    {
      "id": "writing",
      "name": "写作工作台",
      "version": "1.0.0",
      "hostVersion": 1,
      "defaultEnabled": false,
      "dependencies": [
        "ai-assistant"
      ],
      "platforms": [
        "web",
        "desktop",
        "android",
        "ios",
        "cli",
        "worker",
        "server"
      ],
      "capabilities": [
        "writing.sessions",
        "writing.selection"
