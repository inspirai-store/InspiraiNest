{
  "name": "inspirainest",
  "version": "0.2.24",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "collector",
    "apps/desktop/frontend",
    "packages/*"
  ],
  "scripts": {
    "plugins:generate": "node tooling/plugins/generate.mjs",
    "plugins:check": "node tooling/plugins/generate.mjs --check",
    "start": "node services/api/server.mjs",
    "worker": "node services/worker/worker.mjs",
    "desktop": "npm run build && node tooling/launch-desktop.mjs",
    "build": "npm --workspace inspirainest-desktop-frontend run build",
    "test": "npm run plugins:check && npm run check:boundaries && npm run check:ci && node --test tests/plugins/*.test.mjs && npm run test:service && npm run test:frontend",
    "test:service": "npm --workspace inspirainest-collector test",
    "build:web": "vite build --config apps/web/vite.config.ts apps/web",
    "build:all": "npm run plugins:check && npm run build && npm run build:web",
    "check:boundaries": "node tooling/plugins/check-boundaries.mjs",
    "typecheck": "tsc --noEmit -p apps/desktop/frontend/tsconfig.json",
    "build:native-assets": "node collector/scripts/stage-writing.mjs && node collector/scripts/stage-capture.mjs",
    "build:worker-template": "node collector/scripts/stage-worker-template.mjs",
    "build:brand-icons": "node collector/scripts/build-brand-icons.mjs",
    "build:macos-tray-icon": "node collector/scripts/build-macos-tray-icon.mjs",
    "build:worker:win": "npm run build && npm run build:brand-icons && npm run build:worker-template && electron-builder -c infra/electron-builder.yml --win nsis --x64 --publish never",
    "build:worker:mac": "npm run build && npm run build:brand-icons && npm run build:macos-tray-icon && npm run build:worker-template && electron-builder -c infra/electron-builder.yml -c.productName=灵藏 --mac zip dmg --x64 --arm64 -c.mac.identity=- --publish never",
    "build:worker:mac:release": "npm run build && npm run build:brand-icons && npm run build:macos-tray-icon && npm run build:worker-template && electron-builder -c infra/electron-builder.yml -c.productName=灵藏 --mac zip dmg --x64 --arm64 -c.mac.forceCodeSigning=true --publish never",
    "test:frontend": "node --test apps/desktop/frontend/scripts/*.test.mjs",
    "library:build": "node scripts/catalog.mjs build",
    "library:check": "node scripts/catalog.mjs check",
    "check:ci": "node collector/scripts/check-public-ci.mjs"
  },
  "dependencies": {
    "ali-oss": "6.23.0",
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.10",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.4",
    "otpauth": "9.5.1",
    "qrcode": "1.5.4",
    "smol-toml": "1.9.1",
    "yauzl": "3.4.0",
    "@tanstack/react-query": "5.104.2",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "1.55.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.55.1",
    "sharp": "0.35.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "license": "MIT",
  "author": "Wuhan Inspirai Technology Co., Ltd."
}
